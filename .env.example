DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me

# Cloudflare R2 — create an API token at dash.cloudflare.com → R2 → Manage API tokens
R2_ACCOUNT_ID=baec190b8cc3c8c7d0a4e06fb6bdcbc6
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tournament-predictor-assets
# R2_PUBLIC_URL is no longer used for image serving — images are proxied through /api/images/*
# to avoid corporate firewalls that block direct Cloudflare requests.
# Keep this only if you need the direct R2 URL for other purposes.
# R2_PUBLIC_URL=https://pub-xxx.r2.dev/tournament-predictor-assets

# Live (API-linked) tournaments — see docs/LIVE_TOURNAMENTS_PLAN.md
# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# The background sync is OFF unless this is exactly "true". Two developers both running
# `npm run dev` would otherwise share — and exhaust — the account-wide request budget.
LIVE_SYNC_ENABLED=false
# How often the sync scheduler wakes up. It decides per tournament whether to poll.
LIVE_SYNC_TICK_SECONDS=30
# Provider requests a single tick may spend. A full structure sync costs 3, a live-window
# sync 1. Keep the product of this and the tick rate under FOOTBALL_DATA_RATE_LIMIT.
LIVE_SYNC_TICK_BUDGET=6
# Requests per minute the rate limiter allows. The football-data free tier is 10, counted
# per account rather than per process — a running dev server shares it with any script.
FOOTBALL_DATA_RATE_LIMIT=10
#
# Team crests are downloaded from crests.football-data.org once and mirrored into R2, so
# they serve through /api/images/* like every other image. Without R2 configured the
# mirroring is skipped and crests load directly from the provider instead.
#
# NOTE for Claude Code cloud sessions: the provider is NOT reachable on the default
# "Trusted" network policy — requests fail with
#   403 Host not in allowlist: api.football-data.org
# Fix it once per environment: claude.ai/code -> cloud icon above the message box ->
# hover the environment -> settings -> Network access: Custom -> Allowed domains:
#   *.football-data.org
# and tick "Also include default list of common package managers", or npm install
# breaks. Policy is read at VM boot, so start a new session afterwards.
# Docs: https://code.claude.com/docs/en/cloud-environments#allow-specific-domains
# Local development and Railway are unaffected.

# bigballsdata.com — the *fixture* provider for competitions football-data is late with.
# Teams and standings always stay on football-data; a tournament opts in per competition
# from the admin page (Where fixtures come from). Free tier is 1,000 requests/day.
# Key from https://bigballsdata.com/dashboard/keys
BIG_BALLS_API_KEY=
# Requests per minute the limiter allows. The daily cap is the real constraint.
BIG_BALLS_RATE_LIMIT=30
# Override only if the gateway moves.
# BIG_BALLS_BASE_URL=https://api.bigballsdata.com
