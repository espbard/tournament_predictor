DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me

# Cloudflare R2 — create an API token at dash.cloudflare.com → R2 → Manage API tokens
R2_ACCOUNT_ID=baec190b8cc3c8c7d0a4e06fb6bdcbc6
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tournament-predictor-assets
# R2_PUBLIC_URL is no longer used for image serving — images are proxied through /api/images/*
# to avoid corporate firewalls that block direct Cloudflare requests.
# Keep this only if you need the direct R2 URL for other purposes.
# R2_PUBLIC_URL=https://pub-xxx.r2.dev/tournament-predictor-assets

# Live (API-linked) tournaments — see docs/LIVE_TOURNAMENTS_PLAN.md
# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# Set to false to stop the background fixture/score sync (useful in local dev)
LIVE_SYNC_ENABLED=true
# How often the sync scheduler wakes up. It decides per tournament whether to poll.
LIVE_SYNC_TICK_SECONDS=30
#
# NOTE for Claude Code cloud sessions: the provider is NOT reachable on the default
# "Trusted" network policy — requests fail with
#   403 Host not in allowlist: api.football-data.org
# Fix it once per environment: claude.ai/code -> cloud icon above the message box ->
# hover the environment -> settings -> Network access: Custom -> Allowed domains:
#   *.football-data.org
# and tick "Also include default list of common package managers", or npm install
# breaks. Policy is read at VM boot, so start a new session afterwards.
# Docs: https://code.claude.com/docs/en/cloud-environments#allow-specific-domains
# Local development and Railway are unaffected.
